{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "perrito-talk",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "perritos.edevcore.com",
      "custom_domain": true
    }
  ]
}
