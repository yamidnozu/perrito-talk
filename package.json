{
  "name": "perrito-talk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "npm run check:js && vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/*.ts\" \"public/*.{js,css,html}\" \"tests/*.ts\" \"scripts/*.mjs\" package.json README.md .github/workflows/ci.yml",
    "check:js": "for f in public/*.js scripts/*.mjs; do node --check \"$f\" || exit 1; done"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
