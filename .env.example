MODEL_API_KEY=

# Optional enrichments (default on). Mock/watcher-dry always skips them.
USE_SAM=true
USE_ASR=true
SAM_MIN_CONFIDENCE=0.5
# Engineering filters, not validated speech accuracy thresholds.
ASR_MIN_TURN_MS=400
ASR_MIN_WORDS=2
# Only summaries; descriptor analysis always uses Muse Spark 1.3.
SUMMARY_MODEL=muse-spark-1.3
