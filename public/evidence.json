  "combinations": [
    {
      "id": "separation_related_pattern",
      "requires_context": ["owner_absent (user-declared)"],
      "any_of": [
        "sustained vocalization (bark/whine/howl)",
        "destruction near exits",
        "inappropriate elimination",
        "restlessness/pacing",
        "hypersalivation"
      ],
      "min_signs": 2,
      "output_state": "compatible_with_separation_related_problem",
      "certainty": "moderada",
      "citations": ["C35", "C37", "C45"],
      "subtypes": {
        "whine_without_bark": ["separation_fear_component", "C38"],
        "bark_plus_door_scratch": ["separation_frustration_component", "C38"],
        "nonlinear_whines": ["separation_related_stress", "C39"]
      },
      "caveat": "Heterogeneous syndrome; app can say 'compatible', never diagnose. Activity may decrease over hours (C36, via C45), so late stillness ≠ calm."
    },
    {
      "id": "play",
      "any_of": [
        "play_bow",
        "high_long_interval_barks",
        "short_slow_pulsed_growl_bouts"
